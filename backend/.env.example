# Server
NODE_ENV=development
PORT=5000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/vibeclip?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Celery/Job Queue
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Frontend
FRONTEND_URL=http://localhost:3000

# Payments (will be added in Phase 6)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
RAZORPAY_KEY_ID=key_xxx
RAZORPAY_KEY_SECRET=secret_xxx

# AI Services (will be added in Phase 4)
OPENROUTER_API_KEY=sk-xxx

# File Upload
MAX_FILE_SIZE=1073741824
UPLOAD_DIR=./uploads
