# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_VERSION=v1

# Authentication
VITE_AUTH_TOKEN_KEY=vibeclip_token
VITE_REFRESH_TOKEN_KEY=vibeclip_refresh_token
VITE_TOKEN_EXPIRY_HOURS=24

# App Configuration
VITE_APP_NAME=VibeClip AI
VITE_APP_VERSION=0.1.0
VITE_APP_DESCRIPTION=AI-powered video clip generation platform

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=false

# File Upload
VITE_MAX_FILE_SIZE=100MB
VITE_ALLOWED_FILE_TYPES=mp4,mov,avi,mkv

# Development
VITE_DEV_MODE=true
VITE_MOCK_API=false